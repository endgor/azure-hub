{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "azure-hub",
  "compatibility_date": "2026-04-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  // Custom domains for the production worker. Cloudflare manages the DNS
  // records (orange-clouded AAAA to the Workers edge) so the Vercel record
  // is replaced on first deploy. Preview stays on workers.dev only.
  "routes": [
    { "pattern": "azurehub.org", "custom_domain": true },
    { "pattern": "www.azurehub.org", "custom_domain": true }
  ],
  // Per-client-IP quotas. TENANT_LOOKUP protects the Microsoft Graph quota;
  // FEEDBACK stops the contact form being used as a mail relay.
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  "ratelimits": [
    {
      "name": "TENANT_LOOKUP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "env": {
    "preview": {
      "name": "azure-hub-preview",
      "workers_dev": true,
      "ratelimits": [
        {
          "name": "TENANT_LOOKUP_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "FEEDBACK_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 5,
            "period": 60
          }
        }
      ]
    }
  }
}
